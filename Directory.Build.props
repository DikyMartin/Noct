<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(NoRid)' != 'true'">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(NoRid)' != 'true'">false</SelfContained>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Company>Noct</Company>
    <Product>Noct</Product>
    <Version>0.5.1</Version>
    <AssemblyVersion>0.5.1.0</AssemblyVersion>
    <FileVersion>0.5.1.0</FileVersion>
    <Copyright>Noct — personal local FLAC player</Copyright>
  </PropertyGroup>

</Project>
