<!--
    A single outline icon set authored for this project, so there is no third-party icon licence to
    carry. Every glyph is drawn on the same 24x24 grid and rendered with the same 1.5 DIP stroke,
    which keeps weight consistent across the window, the island and the menus. No emoji is used as
    a control.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <sys:Double x:Key="IconStrokeThickness">1.5</sys:Double>
    <sys:Double x:Key="IconSize">20</sys:Double>

    <!-- Transport -->
    <Geometry x:Key="IconPlay">M 8,5 L 19,12 L 8,19 Z</Geometry>
    <Geometry x:Key="IconPause">M 8.5,5 L 8.5,19 M 15.5,5 L 15.5,19</Geometry>
    <Geometry x:Key="IconPrevious">M 7,5 L 7,19 M 19,5 L 9.5,12 L 19,19 Z</Geometry>
    <Geometry x:Key="IconNext">M 17,5 L 17,19 M 5,5 L 14.5,12 L 5,19 Z</Geometry>
    <Geometry x:Key="IconStop">M 7,7 L 17,7 L 17,17 L 7,17 Z</Geometry>

    <!-- Navigation -->
    <Geometry x:Key="IconLibrary">M 4,5 L 4,19 M 8,5 L 8,19 M 12.5,5.5 L 17.5,18.5</Geometry>
    <Geometry x:Key="IconQueue">M 4,7 L 15,7 M 4,12 L 15,12 M 4,17 L 11,17 M 18,10 L 18,19 M 18,10 L 21,9 L 21,18</Geometry>
    <Geometry x:Key="IconSettings">M 12,9.25 A 2.75,2.75 0 1 0 12,14.75 A 2.75,2.75 0 1 0 12,9.25 Z M 12,3.5 L 13,5.8 L 15.4,5.2 L 15.9,7.6 L 18.2,8.3 L 17.3,10.6 L 19,12 L 17.3,13.4 L 18.2,15.7 L 15.9,16.4 L 15.4,18.8 L 13,18.2 L 12,20.5 L 11,18.2 L 8.6,18.8 L 8.1,16.4 L 5.8,15.7 L 6.7,13.4 L 5,12 L 6.7,10.6 L 5.8,8.3 L 8.1,7.6 L 8.6,5.2 L 11,5.8 Z</Geometry>
    <Geometry x:Key="IconFolderAdd">M 3,6.5 L 9,6.5 L 11,9 L 21,9 L 21,18.5 L 3,18.5 Z M 12,11.5 L 12,16 M 9.75,13.75 L 14.25,13.75</Geometry>
    <Geometry x:Key="IconSearch">M 10.5,4.5 A 6,6 0 1 0 10.5,16.5 A 6,6 0 1 0 10.5,4.5 Z M 15,15 L 20,20</Geometry>

