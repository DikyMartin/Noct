    <Geometry x:Key="IconOpenApp">M 5,5.5 L 12,5.5 M 5,5.5 L 5,18.5 L 18,18.5 L 18,11.5 M 13,4.5 L 19.5,4.5 L 19.5,11 M 19.5,4.5 L 11.5,12.5</Geometry>
    <Geometry x:Key="IconClose">M 6,6 L 18,18 M 18,6 L 6,18</Geometry>
