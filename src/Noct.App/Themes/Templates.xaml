<!--
    Shared data templates: the album card (used by Home and the Library grid) and the song row
    layouts (used by All songs, Home, and the open album). Rows carry no event handlers so they can
    live in a resource dictionary; interaction is wired by the views that use them.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:Noct.App.Views"
                    xmlns:vm="clr-namespace:Noct.App.ViewModels">

    <!-- Album card. The command comes from the page that hosts it (Home or Library). -->
    <DataTemplate DataType="{x:Type vm:AlbumCardViewModel}">
        <Button Style="{StaticResource AlbumCardButton}"
                Command="{Binding DataContext.OpenAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                CommandParameter="{Binding}" AutomationProperties.Name="{Binding AccessibleName}">
            <StackPanel>
                <Border Width="152" Height="152" CornerRadius="10" ClipToBounds="True"
                        Background="{StaticResource RaisedSurfaceBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <Grid>
                        <v:GlyphIcon Data="{StaticResource IconNote}" Size="40" StrokeThickness="1.25"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{StaticResource DisabledTextBrush}" />
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </Border>
                <TextBlock Style="{StaticResource BodyText}" FontSize="13" FontWeight="SemiBold" Margin="0,8,0,0"
                           Text="{Binding Title}" ToolTip="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,0" Text="{Binding ArtistText}"
                           ToolTip="{Binding ArtistText}"
                           Visibility="{Binding HasArtist, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Style="{StaticResource CaptionText}" Margin="0,1,0,0" Text="{Binding TrackCountText}" />
            </StackPanel>
        </Button>
    </DataTemplate>

    <!-- Song row: number or playing marker, title and artist, album, format, duration. -->
    <DataTemplate x:Key="TrackRowTemplate" DataType="{x:Type vm:TrackRowViewModel}">
        <Grid Height="{StaticResource TrackRowHeight}" ToolTip="{Binding TooltipText}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="2*" MinWidth="160" />
                <ColumnDefinition Width="1.2*" MinWidth="100" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBlock x:Name="Number" Style="{StaticResource NumericText}" Text="{Binding Number}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <v:GlyphIcon x:Name="Playing" Data="{StaticResource IconSpeaker}" Size="16" Visibility="Collapsed"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="Title" Style="{StaticResource BodyText}" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Artist}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource SecondaryText}" Text="{Binding Album}" VerticalAlignment="Center" Margin="0,0,12,0" />
            <TextBlock Grid.Column="3" Style="{StaticResource NumericText}" Text="{Binding FormatText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="4" Style="{StaticResource NumericText}" Text="{Binding DurationText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Playing" Property="Visibility" Value="Visible" />
                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- Row inside an open album: the album is already known, so that column is left out. -->
    <DataTemplate x:Key="AlbumTrackRowTemplate" DataType="{x:Type vm:TrackRowViewModel}">
        <Grid Height="{StaticResource TrackRowHeight}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="40" />
                <ColumnDefinition Width="*" MinWidth="160" />
                <ColumnDefinition Width="112" />
                <ColumnDefinition Width="52" />
            </Grid.ColumnDefinitions>
            <Grid Grid.Column="0">
                <TextBlock x:Name="Number" Style="{StaticResource NumericText}" Text="{Binding Number}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" />
                <v:GlyphIcon x:Name="Playing" Data="{StaticResource IconSpeaker}" Size="16" Visibility="Collapsed"
                             HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                <TextBlock x:Name="Title" Style="{StaticResource BodyText}" Text="{Binding Title}" ToolTip="{Binding Track.Path}" />
                <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Artist}" />
            </StackPanel>
            <TextBlock Grid.Column="2" Style="{StaticResource NumericText}" Text="{Binding FormatText}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="3" Style="{StaticResource NumericText}" Text="{Binding DurationText}"
                       VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Playing" Property="Visibility" Value="Visible" />
                <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

</ResourceDictionary>
