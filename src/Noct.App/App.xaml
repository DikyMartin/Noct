<Application x:Class="Noct.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Noct.App.Views"
             ShutdownMode="OnExplicitShutdown">
    <!--
        Theme dictionaries (Tokens, Icons, Buttons, Sliders, Inputs) are merged in App.OnStartup, not
        here. Styles freeze the brushes they reference, so the palette has to be decided first:
        a high-contrast session swaps the palette before any style is loaded.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <v:BoolToVisibilityConverter x:Key="BoolToVisibility" />
            <v:InverseBoolConverter x:Key="InverseBool" />
            <v:EqualsConverter x:Key="Equals" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
