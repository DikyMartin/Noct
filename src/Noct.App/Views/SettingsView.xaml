<UserControl x:Class="Noct.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Noct.App.Views"
             xmlns:core="clr-namespace:Noct.Core.Audio;assembly=Noct.Core"
             AutomationProperties.Name="Settings">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False" v:SmoothWheel.Enabled="True">
        <StackPanel Margin="24,8,24,32" MaxWidth="640" HorizontalAlignment="Left">

            <!-- ===== Output ===== -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="Output" Margin="0,8,0,8" />

            <RadioButton Style="{StaticResource OptionRadio}" GroupName="Backend"
                         IsChecked="{Binding Backend, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:OutputBackend.WasapiShared}}">
                <TextBlock Style="{StaticResource BodyText}" Text="Windows shared (WASAPI)" />
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRadio}" GroupName="Backend"
                         IsChecked="{Binding Backend, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:OutputBackend.WasapiExclusive}}">
                <TextBlock Style="{StaticResource BodyText}" Text="Exclusive (WASAPI)" />
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRadio}" GroupName="Backend"
                         IsEnabled="{Binding AsioAvailable}"
                         IsChecked="{Binding Backend, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:OutputBackend.Asio}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource BodyText}" Text="ASIO" />
                    <TextBlock Style="{StaticResource WrappingCaption}" Text="{Binding AsioStatus}" />
                </StackPanel>
            </RadioButton>
            <TextBlock Style="{StaticResource WrappingCaption}" Margin="12,4,0,0" Text="{Binding BackendExplanation}" />

            <TextBlock Style="{StaticResource SectionLabel}" Text="Mode" Margin="0,24,0,8" />
            <RadioButton Style="{StaticResource OptionRadio}" GroupName="Mode"
                         IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:OutputMode.Normal}}">
                <TextBlock Style="{StaticResource BodyText}" Text="Normal" />
            </RadioButton>
            <RadioButton Style="{StaticResource OptionRadio}" GroupName="Mode"
                         IsEnabled="{Binding TransparentAllowed}"
                         IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static core:OutputMode.Transparent}}">
                <TextBlock Style="{StaticResource BodyText}" Text="Transparent" />
            </RadioButton>
            <TextBlock Style="{StaticResource WrappingCaption}" Margin="12,4,0,0" Text="{Binding ModeExplanation}" />

            <TextBlock Style="{StaticResource SectionLabel}" Text="Device" Margin="0,24,0,8" />
            <ListBox Style="{StaticResource PlainListBox}" Padding="0" MaxHeight="180"
                     ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                     AutomationProperties.Name="Output devices">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                        <Setter Property="Padding" Value="12,0" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource BodyText}" Height="34" Padding="0,8,0,0" Text="{Binding Display}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                    Command="{Binding RefreshDevicesCommand}" Content="Refresh devices" />

            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,24" />

            <!-- ===== Format support ===== -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="Format support" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource WrappingCaption}"
                       Text="Asks the selected device which sample rates it accepts in exclusive mode. It does not play anything." />
            <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="0,8,0,8"
                    Command="{Binding CheckFormatsCommand}" Content="Check this device" />
            <TextBlock Style="{StaticResource WrappingCaption}" Text="{Binding FormatStatus}" Margin="0,0,0,8" />
            <ItemsControl ItemsSource="{Binding FormatRows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource NumericText}" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding Format}" />
                            <TextBlock Grid.Column="1" x:Name="Result" Style="{StaticResource CaptionText}" Text="{Binding Result}" />
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Accepted}" Value="False">
                                <Setter TargetName="Result" Property="Foreground" Value="{StaticResource DisabledTextBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Visibility="{Binding HasAttempts, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Style="{StaticResource SectionLabel}" Text="Last negotiation" Margin="0,24,0,8" />
                <ItemsControl ItemsSource="{Binding NegotiationAttempts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Style="{StaticResource WrappingCaption}" Margin="0,1" Text="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,24" />

            <!-- ===== Playback ===== -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="Playback" Margin="0,0,0,12" />
            <CheckBox Style="{StaticResource SwitchToggle}" Content="Gapless playback for tracks in the same format"
                      IsChecked="{Binding GaplessEnabled, Mode=TwoWay}" Margin="0,0,0,12" />
            <CheckBox Style="{StaticResource SwitchToggle}" Content="Show the island when the window is minimized"
                      IsChecked="{Binding IslandEnabled, Mode=TwoWay}" />

            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,24" />

            <!-- ===== Library folders ===== -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="Library folders" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource WrappingCaption}" Margin="0,0,0,8"
                       Text="Noct reads these folders and never changes your music files."
                       Visibility="{Binding HasFolders, Converter={StaticResource BoolToVisibility}}" />
            <ItemsControl ItemsSource="{Binding Folders}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource BodyText}" VerticalAlignment="Center" Text="{Binding}" ToolTip="{Binding}" />
                            <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Remove" Margin="12,0,0,0"
                                    AutomationProperties.Name="Remove folder"
                                    Command="{Binding DataContext.RemoveFolderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button Style="{StaticResource TextButton}" Command="{Binding AddFolderCommand}" Content="Add folder" />
                <Button Style="{StaticResource TextButton}" Margin="8,0,0,0" Content="Rescan"
                        Command="{Binding Library.RescanCommand}" />
            </StackPanel>

            <Rectangle Height="1" Fill="{StaticResource DividerBrush}" Margin="0,24" />

            <!-- ===== About ===== -->
            <TextBlock Style="{StaticResource SectionLabel}" Text="About" Margin="0,0,0,8" />
            <TextBlock Style="{StaticResource BodyText}" Text="{Binding VersionText}" />
            <TextBlock Style="{StaticResource WrappingCaption}" Margin="0,8,0,0"
                       Text="Settings, library index and artwork thumbnails are stored here:" />
            <TextBlock Style="{StaticResource CaptionText}" Foreground="{StaticResource PrimaryTextBrush}" Text="{Binding DataFolder}" />
            <TextBlock Style="{StaticResource WrappingCaption}" Margin="0,8,0,0"
                       Text="Noct never calls a path bit-perfect on its own. Exclusive mode and ASIO are configurations; only a measurement at the DAC can verify them." />
        </StackPanel>
    </ScrollViewer>
</UserControl>
