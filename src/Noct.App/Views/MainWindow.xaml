<Window x:Class="Noct.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Noct.App.Views"
        xmlns:vm="clr-namespace:Noct.App.ViewModels"
        Title="Noct" WindowStyle="None" Width="1120" Height="720" MinWidth="960" MinHeight="600"
        Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource BodyFontFamily}" Foreground="{StaticResource PrimaryTextBrush}"
        Icon="pack://application:,,,/Assets/Noct.ico"
        AutomationProperties.Name="Noct">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="-1"
                      UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="{StaticResource TransportRowHeight}" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{StaticResource NavigationColumnWidth}" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="PanelColumn" Width="272" />
        </Grid.ColumnDefinitions>

        <!-- ===== Navigation (glass) ===== -->
        <Border Grid.Row="0" Grid.Column="0" Background="{DynamicResource GlassTintBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="12,0,12,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,0,0">
                    <Image Source="pack://application:,,,/Assets/NoctMark.png" Width="26" Height="26"
                           RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="Noct logo" />
                    <TextBlock Text="Noct" Style="{StaticResource BodyText}" FontSize="16" FontWeight="SemiBold"
                               Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Row="1" WindowChrome.IsHitTestVisibleInChrome="True">
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" AutomationProperties.Name="Home"
                                 IsChecked="{Binding Section, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppSection.Home}}">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource IconHome}" />
                            <TextBlock Text="Home" Style="{StaticResource BodyText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" AutomationProperties.Name="Now Playing"
                                 IsChecked="{Binding Section, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppSection.NowPlaying}}">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource IconVinyl}" />
                            <TextBlock Text="Now Playing" Style="{StaticResource BodyText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" AutomationProperties.Name="Library"
                                 IsChecked="{Binding Section, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppSection.Library}}">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource IconLibrary}" />
                            <TextBlock Text="Library" Style="{StaticResource BodyText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" AutomationProperties.Name="Queue"
                                 IsChecked="{Binding Section, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppSection.Queue}}">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource IconQueue}" />
                            <TextBlock Text="Queue" Style="{StaticResource BodyText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavButton}" GroupName="Nav" AutomationProperties.Name="Settings"
                                 IsChecked="{Binding Section, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:AppSection.Settings}}">
                        <StackPanel Orientation="Horizontal">
                            <v:GlyphIcon Data="{StaticResource IconSettings}" />
                            <TextBlock Text="Settings" Style="{StaticResource BodyText}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" Margin="12,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Button Grid.Row="3" Style="{StaticResource TextButton}" HorizontalAlignment="Stretch"
                        Command="{Binding Library.AddFolderCommand}" AutomationProperties.Name="Add folder"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                    <StackPanel Orientation="Horizontal">
                        <v:GlyphIcon Data="{StaticResource IconFolderAdd}" Size="18" />
                        <TextBlock Text="Add folder" Style="{StaticResource BodyText}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ===== Centre: toolbar + pages on a stable near-black surface ===== -->
        <Border Grid.Row="0" Grid.Column="1" Background="{StaticResource ListSurfaceBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="{StaticResource ToolbarRowHeight}" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="24,0,0,0" Visibility="{Binding IsLibrary, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MaxWidth="380" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid WindowChrome.IsHitTestVisibleInChrome="True" VerticalAlignment="Center">
                        <TextBox x:Name="SearchBox" Style="{StaticResource SearchBox}"
                                 Text="{Binding Library.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Tag="Search title, artist or album" AutomationProperties.Name="Search library"
                                 PreviewKeyDown="OnSearchKeyDown" />
                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" HorizontalAlignment="Right" Margin="0,0,4,0"
                                Foreground="{StaticResource SecondaryTextBrush}" ToolTip="Clear search"
                                AutomationProperties.Name="Clear search" Command="{Binding Library.ClearSearchCommand}"
                                Visibility="{Binding Library.HasSearchText, Converter={StaticResource BoolToVisibility}}">
                            <v:GlyphIcon Data="{StaticResource IconClose}" Size="14" />
                        </Button>
                    </Grid>
                    <TextBlock Grid.Column="1" Style="{StaticResource CaptionText}" Margin="16,0,0,0" VerticalAlignment="Center"
                               Text="{Binding Library.CountText}" />
                </Grid>

                <Grid Grid.Row="1">
                    <v:HomeView DataContext="{Binding Home}"
                                Visibility="{Binding DataContext.IsHome, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                    <v:LibraryView DataContext="{Binding Library}"
                                   Visibility="{Binding DataContext.IsLibrary, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                    <v:NowPlayingView x:Name="NowPlayingPage"
                                      Visibility="{Binding DataContext.IsNowPlaying, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                    <v:QueueView DataContext="{Binding Playback}"
                                 Visibility="{Binding DataContext.IsQueue, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                    <v:SettingsView DataContext="{Binding Settings}"
                                    Visibility="{Binding DataContext.IsSettings, ElementName=Root, Converter={StaticResource BoolToVisibility}}" />
                </Grid>

                <!-- Playback notices: the reason and, where one exists, what to do about it. -->
                <Border Grid.Row="2" Margin="16,0,16,12" Padding="14,10" CornerRadius="10"
                        Background="{StaticResource RaisedSurfaceBrush}" BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1"
                        Visibility="{Binding Playback.HasNotice, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <v:GlyphIcon x:Name="NoticeIcon" Data="{StaticResource IconInfo}" Size="18" Margin="0,1,12,0" VerticalAlignment="Top"
                                     Foreground="{StaticResource SecondaryTextBrush}" />
                        <StackPanel Grid.Column="1" AutomationProperties.LiveSetting="Assertive">
                            <TextBlock Style="{StaticResource WrappingBody}" Foreground="{StaticResource PrimaryTextBrush}"
                                       Text="{Binding Playback.NoticeMessage}" />
                            <TextBlock Style="{StaticResource WrappingCaption}" Margin="0,4,0,0" Text="{Binding Playback.NoticeAction}"
                                       Visibility="{Binding Playback.HasNoticeAction, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="8,-4,-6,0" VerticalAlignment="Top"
                                Foreground="{StaticResource SecondaryTextBrush}" ToolTip="Dismiss" AutomationProperties.Name="Dismiss message"
                                Command="{Binding Playback.DismissNoticeCommand}">
                            <v:GlyphIcon Data="{StaticResource IconClose}" Size="14" />
                        </Button>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ===== Right: artwork and information (glass), collapses when narrow ===== -->
        <Border Grid.Row="0" Grid.Column="2" Background="{DynamicResource GlassTintBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="1,0,0,0"
                Visibility="{Binding ShowArtworkPanel, Converter={StaticResource BoolToVisibility}}">
            <v:NowPlayingPanel DataContext="{Binding Playback}" />
        </Border>

        <!-- ===== Bottom transport (glass) ===== -->
        <Border Grid.Row="1" Grid.ColumnSpan="3" Background="{DynamicResource GlassTintBrush}"
                BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
            <v:TransportBar DataContext="{Binding Playback}" />
        </Border>

        <!-- ===== Window buttons ===== -->
        <StackPanel Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                    WindowChrome.IsHitTestVisibleInChrome="True">
            <Button Style="{StaticResource CaptionButton}" Click="OnMinimizeClick" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                <v:GlyphIcon Data="{StaticResource IconMinimize}" Size="16" />
            </Button>
            <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Click="OnMaximizeClick" ToolTip="Maximize" AutomationProperties.Name="Maximize">
                <v:GlyphIcon x:Name="MaximizeGlyph" Data="{StaticResource IconMaximize}" Size="16" />
            </Button>
            <Button Style="{StaticResource CloseCaptionButton}" Click="OnCloseClick" ToolTip="Close" AutomationProperties.Name="Close">
                <v:GlyphIcon Data="{StaticResource IconClose}" Size="16" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
