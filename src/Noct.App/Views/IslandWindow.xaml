<Window x:Class="Noct.App.Views.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:Noct.App.Views"
        Title="Noct island" Width="240" Height="36"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" ShowActivated="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent" Focusable="False"
        FontFamily="{StaticResource BodyFontFamily}" Foreground="{StaticResource PrimaryTextBrush}"
        AutomationProperties.Name="Noct mini player">

    <!--
        One layer draws the shape and one layer holds the content. Both use the SAME geometry object:
        the body is filled with it and the content is clipped by it, so nothing (background, panels,
        controls) can show outside the outline. The window itself is per-pixel transparent, so there
        is no rectangular native frame, backdrop or shadow behind the shape.
    -->
    <Grid x:Name="Root" Background="Transparent" MouseEnter="OnRootMouseEnter" MouseLeave="OnRootMouseLeave">
        <Grid x:Name="Stage">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="Lift" />
            </Grid.RenderTransform>

            <Path x:Name="Body" Fill="{DynamicResource IslandTintBrush}" Stroke="{x:Null}"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" />

            <Grid x:Name="ContentLayer" UseLayoutRounding="True">
                <!-- ===== Compact: small artwork and a short title ===== -->
                <Grid x:Name="CompactPanel" Width="220" Height="36" HorizontalAlignment="Center" VerticalAlignment="Top"
                      AutomationProperties.Name="{Binding NowPlayingDescription}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="22" Height="22" CornerRadius="6" ClipToBounds="True" VerticalAlignment="Center" Margin="14,0,0,0"
                            Background="{StaticResource RaisedSurfaceBrush}">
                        <Grid>
                            <v:GlyphIcon Data="{StaticResource IconNote}" Size="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Foreground="{StaticResource DisabledTextBrush}" />
                            <Image Source="{Binding Artwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                   Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Border>
                    <TextBlock Grid.Column="1" Style="{StaticResource BodyText}" FontSize="12" Margin="10,0,16,0"
                               VerticalAlignment="Center" Text="{Binding CompactText}" />
                </Grid>

                <!-- ===== Expanded: artwork, title, transport, seek, open app ===== -->
                <Grid x:Name="ExpandedPanel" Width="420" Height="128" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed">
                    <Grid Margin="16,16,16,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Width="96" Height="96" CornerRadius="10" ClipToBounds="True" VerticalAlignment="Top"
                                Background="{StaticResource RaisedSurfaceBrush}">
                            <Grid>
                                <v:GlyphIcon Data="{StaticResource IconNote}" Size="32" StrokeThickness="1.25"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Foreground="{StaticResource DisabledTextBrush}" />
                                <Image Source="{Binding Artwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                                       Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Column="1" Margin="14,-4,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" Text="{Binding Title}" ToolTip="{Binding Title}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Artist}" />
                                </StackPanel>
                                <Button x:Name="OpenAppButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="30" Height="30"
                                        Foreground="{StaticResource SecondaryTextBrush}" Margin="8,0,-6,0" VerticalAlignment="Top"
                                        ToolTip="Open Noct" AutomationProperties.Name="Open Noct" Click="OnOpenAppClick">
                                    <v:GlyphIcon Data="{StaticResource IconOpenApp}" Size="18" />
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}"
                                        ToolTip="Previous" AutomationProperties.Name="Previous track">
                                    <v:GlyphIcon Data="{StaticResource IconPrevious}" Size="18" />
                                </Button>
                                <Button x:Name="PlayButton" Style="{StaticResource PlayButtonSmall}" Margin="8,0"
                                        Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseName}"
                                        AutomationProperties.Name="{Binding PlayPauseName}">
                                    <v:GlyphIcon x:Name="PlayGlyph" Data="{StaticResource IconPlay}" Filled="True" Size="16" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}"
                                        ToolTip="Next" AutomationProperties.Name="Next track">
                                    <v:GlyphIcon Data="{StaticResource IconNext}" Size="18" />
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="2" Height="18">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource NumericText}" FontSize="11" Text="{Binding ElapsedText}" VerticalAlignment="Center" />
                                <v:SeekBar x:Name="Seek" Grid.Column="1" Style="{StaticResource RailSlider}"
                                           Value="{Binding ProgressFraction, Mode=OneWay}" IsEnabled="{Binding CanSeek}"
                                           AutomationProperties.Name="Seek" />
                                <TextBlock Grid.Column="2" Style="{StaticResource NumericText}" FontSize="11" Text="{Binding RemainingText}"
                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
