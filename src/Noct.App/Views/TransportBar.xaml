<UserControl x:Class="Noct.App.Views.TransportBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Noct.App.Views"
             AutomationProperties.Name="Playback controls">
    <Grid Margin="16,0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MinWidth="160" />
            <ColumnDefinition Width="2*" MinWidth="360" />
            <ColumnDefinition Width="*" MinWidth="260" />
        </Grid.ColumnDefinitions>

        <!-- Left: current track, shown only when the side panel has no room for it. -->
        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0"
              Visibility="{Binding DataContext.ShowArtworkPanel, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Button Click="OnArtworkClick" Width="48" Height="48" Padding="0" Cursor="Hand" Margin="0,0,12,0"
                    ToolTip="Open Now Playing" AutomationProperties.Name="Open Now Playing"
                    FocusVisualStyle="{StaticResource InsetFocusRing}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter />
                    </ControlTemplate>
                </Button.Template>
                <Border Width="48" Height="48" CornerRadius="8" ClipToBounds="True" Background="{StaticResource RaisedSurfaceBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <Grid>
                        <v:GlyphIcon Data="{StaticResource IconNote}" Size="20" StrokeThickness="1.25"
                                     Foreground="{StaticResource DisabledTextBrush}" />
                        <Image Source="{Binding Artwork}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasArtwork, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>
            </Button>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource BodyText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Text="{Binding Title}" ToolTip="{Binding Title}" />
                <TextBlock Style="{StaticResource CaptionText}" TextTrimming="CharacterEllipsis" Text="{Binding Artist}" />
            </StackPanel>
        </Grid>

        <!-- Centre: buttons over the seek row -->
        <Grid Grid.Column="1" VerticalAlignment="Center" MaxWidth="560">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Style="{StaticResource IconButton}" Command="{Binding PreviousCommand}"
                        ToolTip="Previous" AutomationProperties.Name="Previous track">
                    <v:GlyphIcon Data="{StaticResource IconPrevious}" />
                </Button>
                <Button x:Name="PlayButton" Style="{StaticResource PlayButton}" Margin="12,0"
                        Command="{Binding PlayPauseCommand}" ToolTip="{Binding PlayPauseName}"
                        AutomationProperties.Name="{Binding PlayPauseName}">
                    <v:GlyphIcon x:Name="PlayGlyph" Data="{StaticResource IconPlay}" Filled="True" Size="20" StrokeThickness="1.5" />
                </Button>
                <Button Style="{StaticResource IconButton}" Command="{Binding NextCommand}"
                        ToolTip="Next" AutomationProperties.Name="Next track">
                    <v:GlyphIcon Data="{StaticResource IconNext}" />
                </Button>
            </StackPanel>

            <Grid Grid.Row="1" Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource NumericText}" Text="{Binding ElapsedText}" VerticalAlignment="Center"
                           HorizontalAlignment="Left" />
                <v:SeekBar x:Name="Seek" Grid.Column="1" Style="{StaticResource RailSlider}"
                           Value="{Binding ProgressFraction, Mode=OneWay}" IsEnabled="{Binding CanSeek}"
                           AutomationProperties.Name="Seek" ToolTip="Seek" />
                <TextBlock Grid.Column="2" Style="{StaticResource NumericText}" Text="{Binding RemainingText}"
                           VerticalAlignment="Center" HorizontalAlignment="Right" />
            </Grid>
        </Grid>

        <!-- Right: repeat, volume, output -->
        <!-- One row, every child centred on the same horizontal line. Rows are 32 DIPs tall, the
             same as the icon buttons, so icon cells, the slider and the label share one centre. -->
        <Grid Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" Height="32">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />   <!-- repeat -->
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="24" />   <!-- volume icon -->
                <ColumnDefinition Width="84" />   <!-- volume slider -->
                <ColumnDefinition Width="40" />   <!-- volume % or DAC -->
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="Auto" /> <!-- output device -->
            </Grid.ColumnDefinitions>

            <ToggleButton x:Name="RepeatButton" Style="{StaticResource IconToggle}"
                          IsChecked="{Binding RepeatActive, Mode=OneWay}" Click="OnRepeatClick"
                          ToolTip="{Binding RepeatName}" AutomationProperties.Name="{Binding RepeatName}">
                <v:GlyphIcon x:Name="RepeatGlyph" Data="{StaticResource IconRepeat}" />
            </ToggleButton>

            <Grid Grid.Column="2" Grid.ColumnSpan="3" ToolTip="{Binding VolumeHint}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="84" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <v:GlyphIcon Data="{StaticResource IconSpeaker}" Size="18" Foreground="{StaticResource SecondaryTextBrush}" />
                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource RailSlider}" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" LargeChange="0.1" SmallChange="0.05"
                        IsSnapToTickEnabled="True" TickFrequency="0.01"
                        Value="{Binding Volume, Mode=TwoWay}" IsEnabled="{Binding VolumeEnabled}"
                        AutomationProperties.Name="Volume" />
                <TextBlock Grid.Column="2" Style="{StaticResource NumericText}" Margin="8,0,0,0"
                           VerticalAlignment="Center" HorizontalAlignment="Left"
                           Text="{Binding VolumeLabel}" />
            </Grid>

            <ToggleButton x:Name="OutputButton" Grid.Column="6" Style="{StaticResource IconToggle}" Width="Auto" Padding="0"
                          ToolTip="Output device" AutomationProperties.Name="Output device"
                          Foreground="{StaticResource PrimaryTextBrush}">
                <StackPanel Orientation="Horizontal" Margin="10,0" VerticalAlignment="Center">
                    <v:GlyphIcon Data="{StaticResource IconSpeaker}" Size="18" />
                    <v:GlyphIcon Data="{StaticResource IconChevronDown}" Size="14" Margin="4,0,0,0" />
                </StackPanel>
            </ToggleButton>

            <Popup x:Name="OutputPopup" PlacementTarget="{Binding ElementName=OutputButton}" Placement="Top"
                   StaysOpen="False" AllowsTransparency="True" HorizontalOffset="-200" VerticalOffset="-8"
                   IsOpen="{Binding IsChecked, ElementName=OutputButton, Mode=TwoWay}">
                <Border Margin="0,0,12,12" Width="340" Background="{StaticResource RaisedSurfaceBrush}" CornerRadius="12"
                        BorderBrush="{StaticResource HairlineStrongBrush}" BorderThickness="1" Padding="8">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.5" Color="Black" />
                    </Border.Effect>
                    <StackPanel x:Name="OutputPanel">
                        <TextBlock Style="{StaticResource SectionLabel}" Margin="8,4,8,6"
                                   Text="{Binding Backend, StringFormat=Output · {0}}" />
                        <ListBox Style="{StaticResource PlainListBox}" Padding="0" MaxHeight="220"
                                 ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice, Mode=TwoWay}"
                                 AutomationProperties.Name="Output devices">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                                    <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                                    <Setter Property="Padding" Value="8,0" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource BodyText}" Height="32" Padding="0,7,0,0" Text="{Binding Display}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <Button Style="{StaticResource TextButton}" Margin="0,8,0,0" Content="Output settings…"
                                Click="OnOutputSettingsClick" />
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>
    </Grid>
</UserControl>
