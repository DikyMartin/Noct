<UserControl x:Class="Noct.App.Views.QueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Noct.App.Views"
             AutomationProperties.Name="Queue">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="24,8,24,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding QueueSummary}" />
            <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Clear queue" Command="{Binding ClearQueueCommand}" />
        </Grid>

        <ListBox Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding QueueItems}"
                 SelectionMode="Single" AutomationProperties.Name="Queue items"
                 Visibility="{Binding QueueIsEmpty, Converter={StaticResource BoolToVisibility}, ConverterParameter=Invert}">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnItemDoubleClick" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Height="{StaticResource TrackRowHeight}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="40" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="52" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>

                        <Grid>
                            <TextBlock x:Name="Number" Style="{StaticResource NumericText}" Text="{Binding Number}"
                                       HorizontalAlignment="Left" VerticalAlignment="Center" />
                            <v:GlyphIcon x:Name="Playing" Data="{StaticResource IconSpeaker}" Size="16" Visibility="Collapsed"
                                         HorizontalAlignment="Left" VerticalAlignment="Center"
                                         Foreground="{StaticResource PrimaryTextBrush}" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock x:Name="Title" Style="{StaticResource BodyText}" Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Artist}" />
                        </StackPanel>
                        <TextBlock Grid.Column="2" Style="{StaticResource NumericText}" Text="{Binding DurationText}"
                                   VerticalAlignment="Center" HorizontalAlignment="Right" />
                        <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28"
                                Foreground="{StaticResource SecondaryTextBrush}" ToolTip="Remove from queue"
                                AutomationProperties.Name="Remove from queue"
                                Command="{Binding DataContext.RemoveQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <v:GlyphIcon Data="{StaticResource IconClose}" Size="14" />
                        </Button>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Playing" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{StaticResource SecondaryText}"
                   Visibility="{Binding QueueIsEmpty, Converter={StaticResource BoolToVisibility}}"
                   Text="The queue is empty. Play a track from your library." />
    </Grid>
</UserControl>
