<UserControl x:Class="Noct.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Noct.App.Views"
             xmlns:vm="clr-namespace:Noct.App.ViewModels"
             AutomationProperties.Name="Library"
             SizeChanged="OnSizeChanged">
    <UserControl.Resources>
        <!-- Defined here, not inside the item style: handlers inside a style setter are not wired up. -->
        <ContextMenu x:Key="RowMenu">
            <MenuItem Header="Play" Click="OnPlayClick" />
            <MenuItem Header="Play next" Click="OnPlayNextClick" />
            <MenuItem Header="Add to queue" Click="OnAddToQueueClick" />
        </ContextMenu>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Scan progress: counts, not a fake percentage, and always cancellable. -->
        <Border Grid.Row="0" Padding="24,10" Background="{StaticResource RaisedSurfaceBrush}"
                Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource SecondaryText}" VerticalAlignment="Center" Text="{Binding ScanStatus}"
                           AutomationProperties.LiveSetting="Polite" />
                <Button Grid.Column="1" Style="{StaticResource TextButton}" Content="Cancel" Command="{Binding CancelScanCommand}" />
            </Grid>
        </Border>

        <Border Grid.Row="0" Padding="24,10" Background="{StaticResource RaisedSurfaceBrush}"
                Visibility="{Binding HasLoadIssue, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource WrappingBody}" Foreground="{StaticResource WarningTextBrush}" Text="{Binding LoadIssue}" />
        </Border>

        <!-- Albums | All songs -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="24,8,24,8"
                    Visibility="{Binding ShowModeSwitch, Converter={StaticResource BoolToVisibility}}">
            <RadioButton Style="{StaticResource SegmentButton}" GroupName="LibraryMode" Content="Albums" Margin="0,0,6,0"
                         IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:LibraryMode.Albums}}" />
            <RadioButton Style="{StaticResource SegmentButton}" GroupName="LibraryMode" Content="All songs"
                         IsChecked="{Binding Mode, Mode=TwoWay, Converter={StaticResource Equals}, ConverterParameter={x:Static vm:LibraryMode.Songs}}" />
        </StackPanel>

        <!-- Album grid: virtualized rows of cards; covers load only for rows that are drawn. -->
        <ItemsControl x:Name="AlbumGrid" Grid.Row="2" ItemsSource="{Binding AlbumRows}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True"
                      AutomationProperties.Name="Albums list"
                      Visibility="{Binding ShowAlbumGrid, Converter={StaticResource BoolToVisibility}}">
            <ItemsControl.Template>
                <ControlTemplate TargetType="ItemsControl">
                    <ScrollViewer Focusable="False" v:SmoothWheel.Enabled="True" CanContentScroll="True" HorizontalScrollBarVisibility="Disabled">
                        <ItemsPresenter Margin="16,0,16,16" />
                    </ScrollViewer>
                </ControlTemplate>
            </ItemsControl.Template>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type vm:AlbumRowViewModel}">
                    <ItemsControl ItemsSource="{Binding Cards}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- All songs -->
        <ListBox x:Name="TrackList" Grid.Row="2" Style="{StaticResource PlainListBox}"
                 ItemsSource="{Binding VisibleRows}" SelectionMode="Extended"
                 ItemTemplate="{StaticResource TrackRowTemplate}"
                 Visibility="{Binding ShowSongList, Converter={StaticResource BoolToVisibility}}"
                 AutomationProperties.Name="Tracks" KeyDown="OnListKeyDown">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                    <EventSetter Event="MouseDoubleClick" Handler="OnRowDoubleClick" />
                    <Setter Property="ContextMenu" Value="{StaticResource RowMenu}" />
                </Style>
            </ListBox.ItemContainerStyle>
        </ListBox>

        <!-- Open album: cover, facts, actions, then its tracks in play order. -->
        <Grid Grid.Row="1" Grid.RowSpan="2" DataContext="{Binding SelectedAlbum}"
              Visibility="{Binding DataContext.HasSelectedAlbum, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Margin="16,8,24,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Style="{StaticResource IconButton}" VerticalAlignment="Top" Foreground="{StaticResource SecondaryTextBrush}"
                        ToolTip="Back to albums" AutomationProperties.Name="Back to albums"
                        Command="{Binding DataContext.CloseAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <v:GlyphIcon Data="{StaticResource IconBack}" />
                </Button>

                <Border Grid.Column="1" Width="168" Height="168" CornerRadius="12" ClipToBounds="True" Margin="8,0,24,0"
                        Background="{StaticResource RaisedSurfaceBrush}"
                        BorderBrush="{StaticResource HairlineBrush}" BorderThickness="1">
                    <Grid>
                        <v:GlyphIcon Data="{StaticResource IconNote}" Size="48" StrokeThickness="1.25"
                                     HorizontalAlignment="Center" VerticalAlignment="Center"
                                     Foreground="{StaticResource DisabledTextBrush}" />
                        <Image Source="{Binding Cover}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding HasCover, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="2" VerticalAlignment="Bottom">
                    <TextBlock Style="{StaticResource TitleText}" TextTrimming="CharacterEllipsis" MaxHeight="64"
                               Text="{Binding Title}" ToolTip="{Binding Title}" />
                    <TextBlock Style="{StaticResource SecondaryText}" Margin="0,4,0,0" Text="{Binding Facts}" />
                    <TextBlock Style="{StaticResource CaptionText}" Margin="0,2,0,12" Text="{Binding FolderPath}" ToolTip="{Binding FolderPath}" />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" AutomationProperties.Name="Play album"
                                Command="{Binding DataContext.PlayAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <v:GlyphIcon Data="{StaticResource IconPlay}" Filled="True" Size="16" Margin="0,0,8,0"
                                             Foreground="{StaticResource OnLightTextBrush}" />
                                <TextBlock Text="Play album" Foreground="{StaticResource OnLightTextBrush}" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Height="38" Margin="8,0,0,0" AutomationProperties.Name="Shuffle album"
                                Command="{Binding DataContext.ShuffleAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal">
                                <v:GlyphIcon Data="{StaticResource IconShuffle}" Size="18" Margin="0,0,8,0" />
                                <TextBlock Text="Shuffle album" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Height="38" Margin="8,0,0,0" Content="Remove from library"
                                Foreground="{StaticResource SecondaryTextBrush}" AutomationProperties.Name="Remove album from library"
                                ToolTip="Removes this album from Noct. Your music files stay on disk."
                                Command="{Binding DataContext.RemoveAlbumCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                CommandParameter="{Binding}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <ListBox x:Name="AlbumTrackList" Grid.Row="1" Style="{StaticResource PlainListBox}" ItemsSource="{Binding Rows}"
                     SelectionMode="Single" ItemTemplate="{StaticResource AlbumTrackRowTemplate}"
                     AutomationProperties.Name="Album tracks" KeyDown="OnAlbumListKeyDown">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource RowItem}">
                        <Setter Property="AutomationProperties.Name" Value="{Binding Title}" />
                        <EventSetter Event="MouseDoubleClick" Handler="OnAlbumRowDoubleClick" />
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Grid>

        <!-- Empty library: one action and one short sentence. -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource WrappingBody}" TextAlignment="Center" FontSize="14"
                       Text="Add a folder with FLAC files to build your library." />
            <Button Style="{StaticResource PrimaryButton}" Margin="0,16,0,0" HorizontalAlignment="Center"
                    Command="{Binding AddFolderCommand}" AutomationProperties.Name="Add folder">
                <StackPanel Orientation="Horizontal">
                    <v:GlyphIcon Data="{StaticResource IconFolderAdd}" Size="18" Margin="0,0,8,0" />
                    <TextBlock Text="Add folder" Foreground="{StaticResource OnLightTextBrush}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                   Style="{StaticResource SecondaryText}"
                   Visibility="{Binding NoResults, Converter={StaticResource BoolToVisibility}}"
                   Text="Nothing matches your search." />

        <!-- Unreadable files, named with the reason. -->
        <Border Grid.Row="3" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasProblems, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <Button Style="{StaticResource TextButton}" HorizontalAlignment="Left" Margin="16,8"
                        Command="{Binding ToggleProblemsCommand}" Content="{Binding ProblemsSummary}" />
                <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto" Margin="16,0,16,8"
                              Visibility="{Binding ShowProblems, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding Problems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,4">
                                    <TextBlock Style="{StaticResource BodyText}" Text="{Binding FileName}" ToolTip="{Binding Folder}" />
                                    <TextBlock Style="{StaticResource CaptionText}" Text="{Binding Reason}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
