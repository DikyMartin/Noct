<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AssemblyName>Noct.Core</AssemblyName>
    <RootNamespace>Noct.Core</RootNamespace>
    <!-- Core holds the decoder, playback coordination, library and settings.
         It depends on NAudio for Windows audio output, hence the -windows TFM. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- Versions verified against nuget.org on 2026-10-28 and restored successfully. -->
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
    <PackageReference Include="NAudio.Asio" Version="3.3.0" />
    <PackageReference Include="NAudio.Core" Version="3.3.0" />
  </ItemGroup>

</Project>
